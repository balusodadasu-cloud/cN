import java.util.Scanner;

class DistanceVector {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n;
        int[][] cost = new int[10][10];
        int[][] dist = new int[10][10];

        System.out.print("Enter number of nodes: ");
        n = sc.nextInt();

        System.out.println("Enter cost matrix (999 for no connection):");

        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++) {
                cost[i][j] = sc.nextInt();
                dist[i][j] = cost[i][j];
            }

        for (int k = 0; k < n; k++)
            for (int i = 0; i < n; i++)
                for (int j = 0; j < n; j++)
                    if (dist[i][k] + dist[k][j] < dist[i][j])
                        dist[i][j] = dist[i][k] + dist[k][j];

        for (int i = 0; i < n; i++) {
            System.out.println("\nRouting Table for Node " + i);
            System.out.println("Destination\tDistance");

            for (int j = 0; j < n; j++)
                System.out.println(j + "\t\t" + dist[i][j]);
        }

        sc.close();
    }
}
